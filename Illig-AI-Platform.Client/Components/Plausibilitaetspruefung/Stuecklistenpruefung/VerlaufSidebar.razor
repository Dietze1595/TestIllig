@if (!Offen)
{
    <button type="button" class="su-verlauf__toggle" title="Historie" @onclick="() => OffenChanged.InvokeAsync(true)">
        <svg class="su-verlauf__toggle-icon" viewBox="0 -960 960 960" aria-hidden="true">
            <path d="M480-120q-138 0-240.5-91.5T122-440h82q14 104 92.5 172T480-200q117 0 198.5-81.5T760-480q0-117-81.5-198.5T480-760q-69 0-129 32t-101 88h110v80H120v-240h80v94q51-64 124.5-104T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Zm112-152L440-440v-240h80v206l128 128-56 56Z" />
        </svg>
    </button>
}

<aside class="su-verlauf @(Offen ? "su-verlauf--offen" : "")">
    <div class="su-verlauf__head">
        <h3>Dokumente</h3>
        <button type="button" class="su-verlauf__close" title="Schließen" @onclick="() => OffenChanged.InvokeAsync(false)">✕</button>
    </div>
    <div class="su-verlauf__filter">
        <button type="button" class="su-verlauf__filter-btn @(!NurMeine ? "su-verlauf__filter-btn--aktiv" : "")"
                @onclick="() => NurMeineChanged.InvokeAsync(false)">Alle</button>
        <button type="button" class="su-verlauf__filter-btn @(NurMeine ? "su-verlauf__filter-btn--aktiv" : "")"
                @onclick="() => NurMeineChanged.InvokeAsync(true)">Meine</button>
    </div>

    @if (Laedt)
    {
        <p class="su-review__empty">Lädt…</p>
    }
    else if (Fehler)
    {
        <p class="su-review__empty">
            Historie konnte nicht geladen werden.
            <button type="button" class="btn btn-link p-0" @onclick="OnRetry">Erneut versuchen</button>
        </p>
    }
    else
    {
        <section class="su-verlauf__gruppe" aria-labelledby="su-verlauf-eigene">
            <h4 id="su-verlauf-eigene">@(NurMeine ? "Meine Uploads" : "Alle Uploads")</h4>
            @if (Eintraege.Count == 0)
            {
                <p class="su-review__empty">Noch keine Uploads.</p>
            }
            else
            {
                <ul class="su-verlauf__liste">
                    @foreach (var eintrag in Eintraege)
                    {
                        <li>
                            @{ var wirdGeladen = LadenderId == eintrag.Id; }
                            <button type="button"
                                    class="su-verlauf__eintrag @(GeoeffneterId == eintrag.Id ? "su-verlauf__eintrag--aktiv" : "") @(wirdGeladen ? "su-verlauf__eintrag--laedt" : "")"
                                    aria-busy="@wirdGeladen"
                                    disabled="@(LadenderId.HasValue || LadendeSharePointId.HasValue)"
                                    @onclick="() => OnEintragOeffnen.InvokeAsync(eintrag)">
                                <strong>
                                    @eintrag.Auftragsnummer
                                    @if (!NurMeine)
                                    {
                                        <span class="su-verlauf__uploader">@(string.IsNullOrWhiteSpace(eintrag.HochgeladenVon) ? "Unbekannt" : eintrag.HochgeladenVon)</span>
                                    }
                                </strong>
                                <span>@eintrag.Maschinentyp</span>
                                <span class="su-verlauf__datum">@eintrag.ErstelltAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                @if (wirdGeladen)
                                {
                                    <span class="su-verlauf__ladebalken" role="progressbar" aria-label="Historieneintrag wird geladen"><span></span></span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="su-verlauf__gruppe" aria-labelledby="su-verlauf-sharepoint">
            <h4 id="su-verlauf-sharepoint">SharePoint</h4>
            @if (SharePointEintraege.Count == 0)
            {
                <p class="su-review__empty">Noch keine synchronisierten Dokumente.</p>
            }
            else
            {
                <ul class="su-verlauf__liste">
                    @foreach (var eintrag in SharePointEintraege)
                    {
                        <li>
                            @{ var wirdGeladen = LadendeSharePointId == eintrag.Id; }
                            <button type="button"
                                    class="su-verlauf__eintrag @(GeoeffneteSharePointId == eintrag.Id ? "su-verlauf__eintrag--aktiv" : "") @(wirdGeladen ? "su-verlauf__eintrag--laedt" : "")"
                                    aria-busy="@wirdGeladen"
                                    disabled="@(LadenderId.HasValue || LadendeSharePointId.HasValue)"
                                    @onclick="() => OnSharePointEintragOeffnen.InvokeAsync(eintrag)">
                                <strong>@eintrag.Auftragsnummer</strong>
                                <span>@eintrag.Maschinentyp</span>
                                <span class="su-verlauf__datum">@(eintrag.Datum?.ToString("dd.MM.yyyy") ?? eintrag.SharePointGeaendertAm.ToLocalTime().ToString("dd.MM.yyyy"))</span>
                                @if (wirdGeladen)
                                {
                                    <span class="su-verlauf__ladebalken" role="progressbar" aria-label="SharePoint-Dokument wird geladen"><span></span></span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</aside>

@code {
    /// <summary>Ob die Historie eingeklappt (nur Toggle-Button) oder ausgeklappt ist. Wird vom
    /// Elternteil gehalten, weil auch das Haupt-Panel (.su-main) daran seine Breite ausrichtet.</summary>
    [Parameter, EditorRequired]
    public bool Offen { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<bool> OffenChanged { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<VerlaufEintragUebersicht> Eintraege { get; set; } = [];

    [Parameter]
    public IReadOnlyList<AuftragsdokumentUebersicht> SharePointEintraege { get; set; } = [];

    [Parameter]
    public bool Laedt { get; set; }

    [Parameter]
    public bool Fehler { get; set; }

    [Parameter]
    public int? GeoeffneterId { get; set; }

    [Parameter]
    public int? LadenderId { get; set; }

    [Parameter]
    public int? GeoeffneteSharePointId { get; set; }

    [Parameter]
    public int? LadendeSharePointId { get; set; }

    [Parameter]
    public bool NurMeine { get; set; }

    [Parameter]
    public EventCallback<bool> NurMeineChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnRetry { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<VerlaufEintragUebersicht> OnEintragOeffnen { get; set; }

    [Parameter]
    public EventCallback<AuftragsdokumentUebersicht> OnSharePointEintragOeffnen { get; set; }
}
