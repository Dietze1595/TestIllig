@* Einheitlicher Seitenkopf (Titel + optionaler Lead-Text). Ersetzt das pro Seite
   kopierte <header class="sm-page__head">…</header>-Markup. *@
<header class="sm-page__head">
    <h1>@Titel</h1>
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <p class="lead">@Lead</p>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Titel { get; set; } = "";
    [Parameter] public string? Lead { get; set; }
}
