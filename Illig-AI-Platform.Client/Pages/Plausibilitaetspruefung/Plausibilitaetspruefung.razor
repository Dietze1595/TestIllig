    else
    {
        <SeitenKopf Titel="Sondermerkmalsuche"
                     Lead="SAP-Auftrags- bzw. Merkmalsnummer eingeben, um die Sondermerkmale auszulesen." />

        <SondermerkmalsucheStepper />

        <div class="sm-wizard-content">
        <section class="sm-card sm-search-card">
            <div class="sm-search-card__intro">
                <h2>Welchen Auftrag möchtest du prüfen?</h2>
                <p>Starte mit einer SAP-Auftragsnummer oder suche direkt nach einem Sondermerkmal.</p>
            </div>

            <label class="form-label" for="auftrag">SAP-Auftrags- bzw. Merkmalsnummer</label>
            <div class="sm-search-row">
                <input id="auftrag" class="form-control" @bind="_auftragsnummer" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await Weiter(); })"
                       autocomplete="off"
                       placeholder="z. B. 11055627 oder 11055627 / 40" />
                <button class="btn btn-primary" @onclick="Weiter"
                        disabled="@(_checking || string.IsNullOrWhiteSpace(_auftragsnummer))">
                    @(_checking ? "Wird geprüft …" : "Analysieren →")
                </button>
            </div>
            <div class="sm-search-card__formats" aria-label="Gültige Eingabeformate">
                <span><strong>Auftrag</strong> 8-stellig, beginnt mit 11 – optional mit Linie, z. B. / 40</span>
                <span><strong>Sondermerkmal</strong> 6- oder 7-stellig</span>
            </div>
            @if (_fehler is { Length: > 0 })
            {
                <div class="alert alert-warning mt-2 mb-0" role="alert" aria-live="polite">@_fehler</div>
            }
        </section>
        </div>
    }
    </RoleGuard>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? Modus { get; set; }

    // Ein Auftrag ist 8-stellig (beginnt mit 11) und kann optional um eine Linie ergänzt werden,
    // z. B. "11055627 / 40" (Schrägstrich mit oder ohne Leerzeichen). Ohne Linie werden die
    // Sondermerkmale aller Linien angezeigt, mit Linie nur die dieser Linie.
    private static readonly Regex AuftragsnummerMuster = new(@"^(11\d{6})(?:\s*/\s*(\d{1,4}))?$");
    private static readonly Regex MerkmalsnummerMuster = new(@"^\d{6,7}$");

    private string _auftragsnummer = "";
    private string? _fehler;
    private bool _checking;

    private bool IsSondermerkmalsuche =>
        string.Equals(Modus, "sondermerkmalsuche", StringComparison.OrdinalIgnoreCase);

    private void StartSondermerkmalsuche()
        => Nav.NavigateTo($"{AppRoutes.Plausibilitaetspruefung}?modus=sondermerkmalsuche");

    private void StartStuecklistenpruefung()
        => Nav.NavigateTo(AppRoutes.Stuecklistenpruefung);

    private async Task Weiter()
    {
        if (_checking) return;

        var eingabe = _auftragsnummer.Trim();
        if (string.IsNullOrWhiteSpace(eingabe)) return;

        _fehler = null;
        var auftragTreffer = AuftragsnummerMuster.Match(eingabe);
        if (!auftragTreffer.Success && !MerkmalsnummerMuster.IsMatch(eingabe))
        {
            _fehler = "Bitte eine gültige Auftragsnummer (8-stellig, beginnt mit 11, optional mit Linie wie / 40) oder Sondermerkmalsnummer (6- oder 7-stellig) eingeben.";
            return;
        }

        _checking = true;
        StateHasChanged();
        try
        {
            if (auftragTreffer.Success)
            {
                // Eingabe auf die kanonische Form "<Nummer> / <Linie>" bringen, damit URL und
                // Anzeige unabhängig von der Schreibweise ("11055627/40", "11055627 / 40") gleich sind.
                var auftragsnummer = auftragTreffer.Groups[2].Success
                    ? $"{auftragTreffer.Groups[1].Value} / {auftragTreffer.Groups[2].Value}"
                    : auftragTreffer.Groups[1].Value;

                var analyse = await Client.AnalyzeAsync(auftragsnummer);
                if (analyse is null)
                {
                    _fehler = $"Auftrag {auftragsnummer} wurde in der Datenbank nicht gefunden.";
                    return;
                }

                Nav.NavigateTo($"/sondermerkmale?auftragsnummer={Uri.EscapeDataString(auftragsnummer)}");
                return;
            }

            var treffer = await Client.SearchAsync(new SearchRequest(null, [eingabe]));
            if (treffer.Count == 0)
            {
                _fehler = $"Sondermerkmal {eingabe} wurde in der Datenbank nicht gefunden.";
                return;
            }

            Nav.NavigateTo($"/referenztreffer?merkmale={Uri.EscapeDataString(eingabe)}");
        }
        catch (ApiRequestException ex)
        {
            _fehler = $"Die Datenbankprüfung ist fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _checking = false;
        }
    }
}
