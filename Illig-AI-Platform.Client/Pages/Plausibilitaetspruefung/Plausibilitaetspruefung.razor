                    <circle cx="147" cy="72" r="9.5" fill="none" stroke="#ffffff" stroke-width="5" />
                    <path d="M154,79 L165,90" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" />
                </svg>
