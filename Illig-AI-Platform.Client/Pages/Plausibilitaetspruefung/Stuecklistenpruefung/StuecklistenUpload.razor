    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        AufbauVorgangVerwerfen();
        _apiError = null;
        _uploadKonflikt = null;
        _analyzing = true;
        try
        {
            using var stream = e.File.OpenReadStream(StuecklistenpruefungClient.MaxDateiBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _auftragsinformationBytes = ms.ToArray();
            _auftragsinformationContentType = e.File.ContentType;
            _pdfDataUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(_auftragsinformationBytes)}";
            _dokumentName = e.File.Name;
            // Eingeklappt starten, aber vorladen (siehe VerlaufOeffnen).
            _pdfEingeklappt = true;

            _ergebnis = await Client.AnalyzeAsync(e.File);
            _umsetzungsmatrixVerfuegbar = _ergebnis.UmsetzungsmatrixVorhanden;
            _verfuegbareUmsetzungsmatrizen = _ergebnis.VerfuegbareUmsetzungsmatrizen ?? [];
            _ausgeklappteBeschreibungen.Clear();
            _readOnly = false;
            _geoeffneteSharePointId = null;
            _aktiverVerlaufId = _ergebnis.VerlaufId;
            _sapDateiname = null;

            if (_ergebnis.BestehenderEintrag is { } bestehend)
            {
                _uploadKonflikt = bestehend;
                _geoeffneterVerlaufId = null;
                _angezeigterSchritt = 1;
                _hoechsterErreichterSchritt = 1;
            }
            else
            {
                // Neuer Durchlauf: frischer Auftrag oder eigener Durchlauf eines fremd angelegten Dokuments.
                _merkmale = [.. _ergebnis.Merkmale];
                _sonderoptionen = [.. _ergebnis.Sonderoptionen];
                _geoeffneterVerlaufId = null;
                _stueckliste = null;
                _stuecklisteGesucht = false;
                VergleichZuruecksetzen();
                _angezeigterSchritt = 2;
                _hoechsterErreichterSchritt = 2;
            }
            await VerlaufLadenAsync();
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
            _pdfDataUrl = null;
            _dokumentName = null;
        }
        catch (IOException)
        {
            _apiError = "Datei konnte nicht gelesen werden (max. 20 MB).";
            _pdfDataUrl = null;
            _dokumentName = null;
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task BestehendenStandOeffnenAsync()
