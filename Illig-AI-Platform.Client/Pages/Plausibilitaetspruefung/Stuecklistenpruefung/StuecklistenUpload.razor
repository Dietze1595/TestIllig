            _sonderoptionen = [.. bestehend.Sonderoptionen];
            _geoeffneterVerlaufId = bestehend.Id;
            _aktiverVerlaufId = bestehend.Id;
            _stueckliste = bestehend.Stueckliste;
            _stuecklisteGesucht = bestehend.Stueckliste is not null || bestehend.ErreichterSchritt >= 3;
