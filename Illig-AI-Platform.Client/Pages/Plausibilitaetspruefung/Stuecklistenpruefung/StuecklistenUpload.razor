    private async Task VerlaufLadenAsync()
    {
        _verlaufLaedt = true;
        _verlaufFehler = false;
        try
        {
            _verlaufEintraege = [.. await Client.GetVerlaufAsync(_nurMeine)];
            _sharePointEintraege = [.. await Client.GetSharePointAuftragsdokumenteAsync()];
        }
        catch (ApiRequestException)
        {
            // Historie ist ein Zusatz — ein Fehler hier soll den Upload-Flow nicht blockieren,
            // aber der User soll "Laden fehlgeschlagen" von "noch keine Uploads" unterscheiden können.
            _verlaufFehler = true;
        }
        finally
        {
            _verlaufLaedt = false;
        }
    }

    private async Task VerlaufFilterGeaendertAsync(bool nurMeine)
    {
        if (_nurMeine == nurMeine)
            return;

        _nurMeine = nurMeine;
        await VerlaufLadenAsync();
    }

    private void OnSucheInput(ChangeEventArgs e)
    {
        _sucheAuftragsnummer = e.Value?.ToString() ?? "";
        _sucheKeinTrefferHinweis = false;
    }

    private async Task OnSucheKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_sucheLaedt && !string.IsNullOrWhiteSpace(_sucheAuftragsnummer))
            await AuftragsnummerSuchenAsync();
    }

    private async Task AuftragsnummerSuchenAsync()
    {
        if (string.IsNullOrWhiteSpace(_sucheAuftragsnummer))
            return;

        AufbauVorgangVerwerfen();
        _apiError = null;
        _sucheKeinTrefferHinweis = false;
        _sucheLaedt = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var detail = await Client.SucheNachAuftragsnummerAsync(_sucheAuftragsnummer);
            if (detail is null)
            {
                _sucheKeinTrefferHinweis = true;
                return;
            }

            var pdfBytes = detail.Quelle == AuftragsdokumentQuelle.SharePoint
                ? await Client.GetSharePointAuftragsdokumentInhaltAsync(detail.Id)
                : await Client.GetVerlaufDokumentAsync(detail.Id);

            _ergebnis = new DokumentAnalyseErgebnis(
                detail.Auftragsnummer, detail.Kundennummer, detail.Datum, detail.Maschinentyp,
                detail.Merkmale, detail.Sonderoptionen);
            _umsetzungsmatrixVerfuegbar = detail.UmsetzungsmatrixVorhanden;
            _verfuegbareUmsetzungsmatrizen = detail.VerfuegbareUmsetzungsmatrizen ?? [];
            _ausgeklappteBeschreibungen.Clear();
            _merkmale = [.. detail.Merkmale];
            _sonderoptionen = [.. detail.Sonderoptionen];
            _pdfDataUrl = pdfBytes is null
                ? (!string.IsNullOrWhiteSpace(detail.WebUrl) ? detail.WebUrl : null)
                : $"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}";
            _dokumentName = detail.Dateiname;
            _sapDateiname = detail.SapDateiname;

            if (detail.Quelle == AuftragsdokumentQuelle.SharePoint)
            {
                _geoeffneteSharePointId = detail.Id;
                _geoeffneterVerlaufId = null;
                // Denselben Eintrag als aktiven Verlauf führen, damit ein hier durchgeführter
                // Stücklistenvergleich gespeichert wird — der Server übernimmt den (bislang
                // userlosen) SharePoint-Eintrag dann für den aktuellen Bearbeiter.
                _aktiverVerlaufId = detail.Id;
                _stueckliste = null;
                _stuecklisteGesucht = false;
                VergleichZuruecksetzen();
                _angezeigterSchritt = 2;
                _hoechsterErreichterSchritt = 2;
            }
            else
            {
                _geoeffneterVerlaufId = detail.Id;
                _geoeffneteSharePointId = null;
                _aktiverVerlaufId = detail.Id;
                _stueckliste = detail.Stueckliste;
                _stuecklisteGesucht = detail.Stueckliste is not null || detail.ErreichterSchritt >= 3;
                _vergleichsErgebnis = detail.VergleichsErgebnis;
                _baumAnsicht = detail.VergleichsErgebnis is null
                    ? null
                    : VergleichsKnotenAnsicht.Aufbauen(detail.VergleichsErgebnis.Wurzel);

                var wiederhergestellterSchritt = detail.VergleichsErgebnis is not null
                    ? 4
                    : detail.Stueckliste is not null && detail.ErreichterSchritt >= 3
                        ? 3
                        : 2;
                _angezeigterSchritt = wiederhergestellterSchritt;
                _hoechsterErreichterSchritt = wiederhergestellterSchritt;
            }

            // Aktiv über die Suche geöffnete Auftragsinformationen (SharePoint wie Drag&Drop) sind
            // bearbeitbar: Merkmale löschen/ergänzen, Stückliste neu aufbauen, neu vergleichen. Nur
            // die reine SharePoint-Archiv-Ansicht (SharePointDokumentOeffnen) bleibt read-only.
            _readOnly = false;
            _pdfEingeklappt = true;
            _verlaufOffen = false;
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
        }
        finally
        {
            _sucheLaedt = false;
        }
    }

    private async Task VerlaufOeffnen(VerlaufEintragUebersicht eintrag)
    {
        AufbauVorgangVerwerfen();
        _apiError = null;
        _ladenderVerlaufId = eintrag.Id;
        await InvokeAsync(StateHasChanged);
        try
        {
            var detail = await Client.GetVerlaufDetailAsync(eintrag.Id);
            if (detail is null)
                return;

            var pdfBytes = await Client.GetVerlaufDokumentAsync(eintrag.Id);

            _ergebnis = new DokumentAnalyseErgebnis(
                detail.Auftragsnummer, detail.Kundennummer, detail.Datum, detail.Maschinentyp,
                detail.Merkmale, detail.Sonderoptionen);
            _umsetzungsmatrixVerfuegbar = detail.UmsetzungsmatrixVorhanden;
            _verfuegbareUmsetzungsmatrizen = detail.VerfuegbareUmsetzungsmatrizen ?? [];
            _ausgeklappteBeschreibungen.Clear();
            _merkmale = [.. detail.Merkmale];
            _sonderoptionen = [.. detail.Sonderoptionen];
            _pdfDataUrl = pdfBytes is null
                ? (!string.IsNullOrWhiteSpace(detail.WebUrl) ? detail.WebUrl : null)
                : $"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}";
            _dokumentName = eintrag.Dateiname;
            _geoeffneterVerlaufId = eintrag.Id;
            _geoeffneteSharePointId = null;
            _aktiverVerlaufId = eintrag.Id;
            // Historieneintrag ist bearbeitbar: Merkmale löschen/ergänzen und den Durchlauf neu
            // rechnen. Änderungen werden beim Weitergehen (Stückliste aufbauen / vergleichen)
            // gespeichert.
            _readOnly = false;
            _pdfEingeklappt = true;
            _verlaufOffen = false;
            _stueckliste = detail.Stueckliste;
            _stuecklisteGesucht = detail.Stueckliste is not null || detail.ErreichterSchritt >= 3;
            _vergleichsErgebnis = detail.VergleichsErgebnis;
            _baumAnsicht = detail.VergleichsErgebnis is null
                ? null
                : VergleichsKnotenAnsicht.Aufbauen(detail.VergleichsErgebnis.Wurzel);
            _sapDateiname = detail.SapDateiname;

            var wiederhergestellterSchritt = detail.VergleichsErgebnis is not null
                ? 4
                : detail.Stueckliste is not null && detail.ErreichterSchritt >= 3
                    ? 3
                    : 2;
            _angezeigterSchritt = wiederhergestellterSchritt;
            _hoechsterErreichterSchritt = wiederhergestellterSchritt;
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
        }
        finally
        {
            _ladenderVerlaufId = null;
        }
    }

