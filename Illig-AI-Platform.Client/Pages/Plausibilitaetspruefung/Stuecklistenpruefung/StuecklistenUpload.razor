                : VergleichsKnotenAnsicht.Aufbauen(bestehend.VergleichsErgebnis.Wurzel);
            _sapDateiname = bestehend.SapDateiname;
            var schritt = bestehend.VergleichsErgebnis is not null
                ? 4
                : bestehend.Stueckliste is not null && bestehend.ErreichterSchritt >= 3
                    ? 3
                    : 2;
            _angezeigterSchritt = schritt;
            _hoechsterErreichterSchritt = schritt;
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task DokumentNeuEinlesenAsync()
    {
        if (_ergebnis is null
            || _uploadKonflikt is not { } bestehend
            || _auftragsinformationBytes is null
            || _dokumentName is null
            || _auftragsinformationContentType is null)
            return;

        _apiError = null;
        _analyzing = true;
        try
        {
            await Client.VerlaufNeuEinlesenAsync(
                bestehend.Id,
                _auftragsinformationBytes,
                _dokumentName,
                _auftragsinformationContentType,
                _ergebnis);

            _uploadKonflikt = null;
            _merkmale = [.. _ergebnis.Merkmale];
            _sonderoptionen = [.. _ergebnis.Sonderoptionen];
            _geoeffneterVerlaufId = bestehend.Id;
            _aktiverVerlaufId = bestehend.Id;
            _stueckliste = null;
            _stuecklisteGesucht = false;
            VergleichZuruecksetzen();
            _angezeigterSchritt = 2;
            _hoechsterErreichterSchritt = 2;
            await VerlaufLadenAsync();
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
        }
        finally
        {
            _analyzing = false;
        }
    }

    private Task AufbauenAsync()
    {
        if (_ergebnis is null || _aufbauend || !_umsetzungsmatrixVerfuegbar)
            return Task.CompletedTask;

        var ergebnis = _ergebnis;
        var merkmalsnummern = _merkmale.Select(m => m.Merkmalsnummer).ToArray();
        var vorgangId = ++_aufbauVorgangId;
        _apiError = null;
        VergleichZuruecksetzen();
        _stueckliste = null;
        _stuecklisteGesucht = false;
        _aufbauend = true;

        _angezeigterSchritt = 3;
        _hoechsterErreichterSchritt = Math.Max(_hoechsterErreichterSchritt, 3);

        _ = StuecklisteImHintergrundAufbauenAsync(ergebnis, merkmalsnummern, vorgangId);
        return Task.CompletedTask;
    }

    private async Task StuecklisteImHintergrundAufbauenAsync(
        DokumentAnalyseErgebnis ergebnis,
        IReadOnlyList<string> merkmalsnummern,
        int vorgangId)
    {
        try
        {
            var stueckliste = await Client.AufbauenAsync(ergebnis.Maschinentyp, merkmalsnummern);
            if (vorgangId != _aufbauVorgangId || !ReferenceEquals(_ergebnis, ergebnis))
                return;

            _stueckliste = stueckliste;
            _stuecklisteGesucht = true;
            if (_stueckliste is null)
            {
                _umsetzungsmatrixVerfuegbar = false;
                VorgemerkteSapDateiVerwerfen();
            }
            if (_stueckliste is not null)
                await VerlaufStandSpeichernAsync(3);
        }
        catch (ApiRequestException ex)
        {
            if (vorgangId == _aufbauVorgangId)
            {
                _apiError = ex.Message;
                VorgemerkteSapDateiVerwerfen();
            }
        }
        finally
        {
            if (vorgangId == _aufbauVorgangId)
            {
                _aufbauend = false;
                await InvokeAsync(StateHasChanged);
                await VergleichStartenWennBereitAsync();
            }
        }
    }

    private async Task OnSapDateiSelectedAsync(InputFileChangeEventArgs e)
    {
        _apiError = null;
        _vergleichend = true;
        _vergleichsErgebnis = null;
        _baumAnsicht = null;
        try
        {
            using var stream = e.File.OpenReadStream(StuecklistenpruefungClient.MaxDateiBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            _wartendeSapDatei = ms.ToArray();
            _sapDateiname = e.File.Name;
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
            VorgemerkteSapDateiVerwerfen();
        }
        catch (IOException)
        {
            _apiError = "Datei konnte nicht gelesen werden (max. 20 MB).";
            VorgemerkteSapDateiVerwerfen();
        }
        finally
        {
            _vergleichend = false;
            await InvokeAsync(StateHasChanged);
        }

        await VergleichStartenWennBereitAsync();
    }

    private async Task VergleichStartenWennBereitAsync()
    {
        if (_wartendeSapDatei is null ||
            string.IsNullOrWhiteSpace(_sapDateiname) ||
            _stueckliste is null ||
            _aufbauend ||
            _vergleichend)
        {
            return;
        }

        await SapDateiVergleichenAsync(_wartendeSapDatei, _sapDateiname, _stueckliste);
    }

    private async Task SapDateiVergleichenAsync(
        byte[] sapDatei,
        string dateiname,
        StuecklistenKnoten stueckliste)
    {
        if (_ergebnis is null)
            return;

        _vergleichend = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _vergleichsErgebnis = await Client.VergleichenAsync(
                sapDatei,
                dateiname,
                stueckliste,
                _ergebnis.Maschinentyp);
            _baumAnsicht = VergleichsKnotenAnsicht.Aufbauen(_vergleichsErgebnis.Wurzel);
            _angezeigterSchritt = 4;
            _hoechsterErreichterSchritt = Math.Max(_hoechsterErreichterSchritt, 4);
            await VerlaufStandSpeichernAsync(4, dateiname);
            _wartendeSapDatei = null;
        }
        catch (ApiRequestException ex)
        {
            _apiError = ex.Message;
            VorgemerkteSapDateiVerwerfen();
        }
        finally
        {
            _vergleichend = false;
        }
    }

    private static bool HatLangeBeschreibung(string? beschreibung) =>
        !string.IsNullOrWhiteSpace(beschreibung) && beschreibung.Length > BeschreibungVorschauSchwelle;

    private static string BeschreibungKey(string gruppe, ErkanntesMerkmal merkmal) =>
        $"{gruppe}|{merkmal.Position}|{merkmal.Merkmalsnummer}";

    private void BeschreibungUmschalten(string key)
    {
        if (!_ausgeklappteBeschreibungen.Remove(key))
            _ausgeklappteBeschreibungen.Add(key);
    }

    private void RemoveMerkmal(ErkanntesMerkmal merkmal)
    {
        _ausgeklappteBeschreibungen.Remove(BeschreibungKey("merkmal", merkmal));
        _merkmale.Remove(merkmal);
    }

    private void RemoveSonderoption(ErkanntesMerkmal sonderoption)
    {
        _ausgeklappteBeschreibungen.Remove(BeschreibungKey("sonderoption", sonderoption));
        _sonderoptionen.Remove(sonderoption);
    }

    private void AddMerkmal()
    {
        if (!KannHinzufuegen) return;
        var merkmal = new ErkanntesMerkmal(_neuePosition.Trim(), _neueNummer.Trim(), _neueBeschreibung.Trim());
        (_neuesZiel == "Sonderoption" ? _sonderoptionen : _merkmale).Add(merkmal);
        _neuePosition = "";
        _neueNummer = "";
        _neueBeschreibung = "";
    }

    private void Zuruecksetzen()
    {
        AufbauVorgangVerwerfen();
        _ergebnis = null;
        _uploadKonflikt = null;
        _merkmale = [];
        _sonderoptionen = [];
        _ausgeklappteBeschreibungen.Clear();
        _pdfDataUrl = null;
        _dokumentName = null;
        _auftragsinformationBytes = null;
        _auftragsinformationContentType = null;
        _sapDateiname = null;
        _pdfEingeklappt = false;
        _apiError = null;
        _geoeffneterVerlaufId = null;
        _geoeffneteSharePointId = null;
        _aktiverVerlaufId = null;
        _readOnly = false;
        _stueckliste = null;
        _stuecklisteGesucht = false;
        _umsetzungsmatrixVerfuegbar = false;
        _verfuegbareUmsetzungsmatrizen = [];
        VergleichZuruecksetzen();
        _angezeigterSchritt = 1;
        _hoechsterErreichterSchritt = 1;
    }

    private void AufbauVorgangVerwerfen()
    {
        _aufbauVorgangId++;
        _aufbauend = false;
    }

    private void VergleichZuruecksetzen()
    {
        _vergleichsErgebnis = null;
        _baumAnsicht = null;
        VorgemerkteSapDateiVerwerfen();
    }

    private void VorgemerkteSapDateiVerwerfen()
    {
        _wartendeSapDatei = null;
        _sapDateiname = null;
    }

    private async Task VerlaufStandSpeichernAsync(int schritt, string? sapDateiname = null)
    {
        if (_aktiverVerlaufId is not int verlaufId)
            return;

        try
        {
            await Client.VerlaufStandAktualisierenAsync(
                verlaufId,
                schritt,
                _merkmale,
                _sonderoptionen,
                _stueckliste,
                _vergleichsErgebnis,
                sapDateiname);
            await VerlaufLadenAsync();
        }
        catch (ApiRequestException)
        {
            _apiError = "Das Ergebnis ist verfügbar, konnte aber nicht in der Historie gespeichert werden.";
        }
    }
}
