        _umsetzungsmatrixVerfuegbar ? null : "su-available-matrices";

    private void SchrittWechseln(int schritt)
    {
        if (schritt == 1)
        {
            Zuruecksetzen();
            return;
        }
        _angezeigterSchritt = schritt;
    }

